---
import '../styles/article.css';

interface Props {
  title: string;
  lang: string;
}
const { title, lang } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot name="before-main" />
    <main>
      <slot />
    </main>
    <slot name="after-main" />
  </body>
</html>
