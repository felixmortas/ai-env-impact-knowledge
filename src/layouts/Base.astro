---
import '../styles/article.css';

import type { HeadLink } from '../lib/language-links';

interface Props {
  title: string;
  lang: string;
  links?: HeadLink[];
}
const { title, lang, links = [] } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {links.map((l) => <link rel={l.rel} href={l.href} hreflang={l.hreflang} />)}
    <slot name="head" />
  </head>
  <body>
    <slot name="before-main" />
    <main>
      <slot />
    </main>
    <slot name="after-main" />
  </body>
</html>
