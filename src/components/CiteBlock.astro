---
import { t } from '../i18n';
import { getConfig } from '../lib/config';
import { buildCitation } from '../lib/bibtex';
import CopyButton from './CopyButton';

interface Props { title: string }
const { title } = Astro.props;
const entry = buildCitation(getConfig(), title, t('page.lang'), t('cite.accessNote'));
---
<details class="cite-block">
  <summary>{t('cite.label')}</summary>
  <pre class="cite-entry" tabindex="0"><code>{entry}</code></pre>
  <CopyButton client:only="react" text={entry} label={t('cite.copy')} copied={t('cite.copied')} failed={t('cite.failed')} />
</details>
