---
import { t } from '../i18n';
import { getConfig } from '../lib/config';
import { buildCitation } from '../lib/bibtex';
import CopyButton from './CopyButton';

interface Props { title: string; lang: string }
const { title, lang } = Astro.props;
const entry = buildCitation(getConfig(), title, lang, t(lang, 'cite.accessNote'));
---
<details class="cite-block">
  <summary>{t(lang, 'cite.label')}</summary>
  <pre class="cite-entry" tabindex="0"><code>{entry}</code></pre>
  <CopyButton client:only="react" text={entry} label={t(lang, 'cite.copy')} copied={t(lang, 'cite.copied')} failed={t(lang, 'cite.failed')} />
</details>
