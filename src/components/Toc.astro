---
import { t } from '../i18n';
import { buildToc, type Heading } from '../lib/toc';
import TocList from './TocList.astro';

interface Props { headings: Heading[]; references: Heading }
const { headings, references } = Astro.props;
const tree = buildToc(headings, [references]);
---
<nav class="toc" aria-label={t('toc.label')}>
  <TocList nodes={tree} />
</nav>
