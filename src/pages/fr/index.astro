---
import { getEntry, render } from 'astro:content';
import { t } from '../../i18n';
import Base from '../../layouts/Base.astro';
import AuthorBlock from '../../components/AuthorBlock.astro';
import TocProgress from '../../components/TocProgress';
import { buildToc } from '../../lib/toc';

const entry = await getEntry('article', 'fr');
if (!entry) throw new Error("Article français introuvable (src/fr/main.md)");
const { Content, headings } = await render(entry);
const referencesHeading = { depth: 2, slug: 'references', text: t('references.title') };
---
<Base title={entry.data.title}>
      <Fragment set:html={entry.data.h1Html} />
      <AuthorBlock title={entry.data.title} />
      <TocProgress client:load nodes={buildToc(headings, [referencesHeading])} label={t('toc.label')} progressLabel={t('toc.progress')} />
      <Content />
      <section class="references" aria-labelledby="references">
        <h2 id="references">{t('references.title')}</h2>
        <ol class="references-list">
          {entry.data.references.map((ref: { key: string; number: number; calls: number; text: string; url?: string }) => (
            <li id={`ref-${ref.key}`}>
              {ref.text}
              {ref.url && <> <a href={ref.url}>{ref.url}</a></>}
              {Array.from({ length: ref.calls }, (_, k) => (
                <> <a class="backlink" href={`#cite-${ref.number}-${k + 1}`} aria-label={`${t('references.backlink')} ${k + 1}`}>↩</a></>
              ))}
            </li>
          ))}
        </ol>
      </section>
</Base>
